# Your SkyeGate Pro license key.
# Buy at https://skyemeta.com/skyegate/ ($49/mo or $350/yr per domain).
# Same key works on the WordPress plugin and this SDK — one license, two stacks.
# Format: SKYE-XXXX-XXXX-XXXX
NEXT_PUBLIC_SKYE_LICENSE_KEY=SKYE-XXXX-XXXX-XXXX

# WalletConnect Project ID. Free at https://cloud.walletconnect.com/.
# Required for RainbowKit to support WalletConnect-based wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id-here
